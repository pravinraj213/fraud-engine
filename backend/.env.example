# Copy to backend/.env and adjust. Never commit the real .env.
DATABASE_URL=sqlite:///./fraud.db
RULES_CONFIG_PATH=rules.yaml
HIGH_RISK_THRESHOLD=70

# log = write alerts to the server log; ses = send email through Amazon SES
NOTIFIER=log
AWS_REGION=ap-south-1
AWS_PROFILE=fraud-engine
SES_SENDER_EMAIL=alerts@example.com
# One address, or several separated by commas. Every address must be verified while SES is in sandbox.
ALERT_RECIPIENT_EMAIL=you@example.com

CONSOLE_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
